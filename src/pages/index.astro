---
import Base from '../layouts/Base.astro';
import DocCard from '../components/DocCard.astro';
import { byUpdated, getDocs, getRepoMap } from '../lib/docs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = (await getDocs()).sort(byUpdated);
const repos = [...getRepoMap(docs).entries()].sort(([a], [b]) => a.localeCompare(b, 'en'));
---
<Base>
  <section class="hero">
    <h1>Design Docs</h1>
  </section>

  <section>
    <div class="section-heading"><h2>最近更新されたドキュメント</h2><a href={`${base}/repos/`}>すべて見る</a></div>
    <div class="doc-list">
      {docs.slice(0, 8).map((doc) => <DocCard doc={doc} showRepo />)}
    </div>
  </section>

  <section>
    <h2>リポジトリ</h2>
    <div class="repo-grid">
      {repos.map(([repo, repositoryDocs]) => (
        <a class="repo-card" href={`${base}/repos/${repo}/`}>
          <h2>{repo}</h2>
          <p>{repositoryDocs.length} documents</p>
        </a>
      ))}
    </div>
  </section>
</Base>
